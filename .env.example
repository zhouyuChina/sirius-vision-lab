# Load into the process environment before starting the service. Never commit real secrets.
VISION_ROOT=.
VISION_API_KEYS=
# Separate elevated keys for /v1/records; also accepted by other /v1 routes.
VISION_ADMIN_API_KEYS=
# Format: scrypt$<16-byte salt hex>$<64-byte digest hex>
VISION_ADMIN_PASSWORD_HASH=
VISION_SESSION_SECRET=
VISION_PROVIDER=minimax
VISION_MODEL=MiniMax-M3
# Optional override of the selected provider endpoint:
VISION_BASE_URL=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-for-coding
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
Z_AI_API_KEY=
GLM_MODEL=glm-5.3-flash
