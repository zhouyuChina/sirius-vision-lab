# Load into the process environment before starting the service. Never commit real secrets.
VISION_ROOT=.
# Public HTTPS prefix used in render.output_url (no trailing slash).
VISION_PUBLIC_BASE_URL=https://101.37.175.27/vision
VISION_API_KEYS=
# Separate elevated keys for /v1/records; also accepted by other /v1 routes.
VISION_ADMIN_API_KEYS=
# Format: scrypt$<16-byte salt hex>$<64-byte digest hex>
VISION_ADMIN_PASSWORD_HASH=
VISION_SESSION_SECRET=
VISION_PROVIDER=minimax
VISION_MODEL=MiniMax-M3
# Each provider attempt may run for this many seconds. Timeout/429 is retried once.
VISION_TIMEOUT=75
# Bound simultaneous multimodal calls so upstream capacity spikes queue locally.
VISION_MAX_CONCURRENCY=2
VISION_RETRY_BACKOFF=1
# Optional override of the selected provider endpoint:
VISION_BASE_URL=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-for-coding
# Image translation (use credentials from your own account; keep real values outside source control).
# Translation routes through TRANSLATE_PROVIDER (default: qwen) using the QWEN_* credentials below.
# Cross-vendor backup: TRANSLATE_PROVIDER=deepseek + deepseek-chat (thinking variants hang past timeout).
TRANSLATE_PROVIDER=qwen
TRANSLATE_MODEL=qwen3.8-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Allow longer-running full-image edit generation independently of VISION_TIMEOUT.
EDIT_TIMEOUT=180
FONT_PATH_CYRILLIC=/System/Library/Fonts/Supplemental/Arial Bold.ttf
FONT_PATH_CHINESE=/System/Library/Fonts/STHeiti Light.ttc
ARK_API_KEY=
ARK_SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_HOST=llm-9ucxkul4g12vzutq.cn-beijing.maas.aliyuncs.com
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0-pro
# Token Plan image editing; QWEN_IMAGE_BASE_URL defaults to QWEN_BASE_URL without /compatible-mode/v1.
QWEN_API_KEY=
QWEN_IMAGE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com
QWEN_IMAGE_MODEL=qwen-image-3.0-pro
